# ── LLM Provider (at least one required) ──────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# Optional alternative providers (all go through LiteLLM)
# MISTRAL_API_KEY=your-mistral-api-key-here
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ── Per-agent model overrides (default: gemini-2.0-flash) ─────────────
RESEARCH_MODEL=gemini-2.0-flash
PLANNING_MODEL=gemini-2.0-flash
WRITING_MODEL=gemini-2.0-flash
EDITING_MODEL=gemini-2.0-flash
OPTIMIZATION_MODEL=gemini-2.0-flash-lite
ORCHESTRATOR_MODEL=gemini-2.0-flash

# ── Service URLs ──────────────────────────────────────────────────────
LIGHTRAG_URL=http://lightrag:9621
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/acs
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Host / Port ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=3000
